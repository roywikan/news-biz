# SITE_DOMAIN & APP_URL: Domain name tempat aplikasi di-hosting di Cloudflare DNS.
SITE_DOMAIN="yourdomain.com"
APP_URL="https://yourdomain.com"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLOUDFLARE D1 & WORKER CONFIGURATION
CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_DATABASE_ID="your_d1_database_id"

# GITHUB REPOSITORY STORAGE FOR IMAGES
# Penulis mengunggah gambar yang akan disimpan langsung ke repo GitHub (/public/uploads)
GITHUB_TOKEN="ghp_your_github_personal_access_token"
GITHUB_OWNER="username_or_org"
GITHUB_REPO="blog-my-repo"
GITHUB_BRANCH="main"

# JWT Secret untuk Authentication Session
JWT_SECRET="edge-blog-engine-super-secret-key-2026"

